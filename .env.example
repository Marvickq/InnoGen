# InnoGen Autonomous Multi-Agent Research Engine v6.0 — Environment Variables

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://innogen:innogen_secret@localhost:5432/innogen"

# Redis Connection (optional — app runs without it)
REDIS_URL="redis://localhost:6379"

# LLM API Keys — Groq primary, Gemini fallback
GROQ_API_KEY="gsk_..."
GEMINI_API_KEY="AI..."

# Web Search API Keys — Serper primary, Tavily fallback
SEARCH_API_KEY="..."
TAVILY_API_KEY="tvly-..."

# Server Configuration
PORT=3000
NODE_ENV="development"

# Logging
LOG_LEVEL="info"
LOG_FILE="./logs/innogen.log"
