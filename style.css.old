/* ==========================================================================
   INNOGEN - MODERN FINTECH & AI ENTERPRISE DESIGN SYSTEM
   Aesthetic: Dark Space Obsidian, Glassmorphism, Neon Accents & Micro-Animations
   ========================================================================== */

:root {
  /* Color Tokens */
  --bg-space: #07090E;
  --bg-primary: #0B0F19;
  --bg-surface: #111827;
  --bg-surface-elevated: #1F2937;
  
  --glass-bg: rgba(17, 24, 39, 0.70);
  --glass-border: rgba(255, 255, 255, 0.08);
  --glass-border-hover: rgba(99, 102, 241, 0.4);
  --glass-glow-violet: rgba(99, 102, 241, 0.15);
  --glass-glow-teal: rgba(6, 182, 212, 0.15);

  --accent-violet: #6366F1;
  --accent-purple: #8B5CF6;
  --accent-teal: #06B6D4;
  --accent-emerald: #10B981;
  --accent-amber: #F59E0B;
  --accent-rose: #F43F5E;

  --text-primary: #F9FAFB;
  --text-secondary: #9CA3AF;
  --text-muted: #6B7280;

  --border-subtle: rgba(255, 255, 255, 0.08);
  --border-active: rgba(99, 102, 241, 0.6);

  /* Typography */
  --font-main: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-mono: 'JetBrains Mono', monospace;

  /* Spacing & Radius */
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --radius-full: 9999px;

  /* Shadows & Glows */
  --shadow-subtle: 0 4px 20px rgba(0, 0, 0, 0.4);
  --glow-primary: 0 0 25px rgba(99, 102, 241, 0.35);
  --glow-emerald: 0 0 25px rgba(16, 185, 129, 0.35);
}

/* Reset & Global Base */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: var(--font-main);
  background-color: var(--bg-space);
  color: var(--text-primary);
  line-height: 1.5;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

/* Custom Scrollbars */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: var(--bg-space);
}
::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-full);
}
::-webkit-scrollbar-thumb:hover {
  background: var(--accent-violet);
}

/* App Layout Grid */
.app-layout {
  display: flex;
  min-height: 100vh;
  background: radial-gradient(circle at 10% 20%, rgba(99, 102, 241, 0.08) 0%, transparent 40%),
              radial-gradient(circle at 90% 80%, rgba(6, 182, 212, 0.06) 0%, transparent 45%),
              var(--bg-space);
}

/* Sidebar */
.sidebar {
  width: 260px;
  background: rgba(11, 15, 25, 0.85);
  backdrop-filter: blur(20px);
  border-right: 1px solid var(--glass-border);
  display: flex;
  flex-direction: column;
  padding: 24px 16px;
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
}

.brand-container {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 12px 28px 12px;
  border-bottom: 1px solid var(--border-subtle);
}

.brand-name {
  font-size: 1.25rem;
  font-weight: 800;
  letter-spacing: -0.5px;
}
.brand-name .highlight {
  background: linear-gradient(135deg, var(--accent-violet), var(--accent-teal));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.brand-tag {
  display: block;
  font-size: 0.65rem;
  font-family: var(--font-mono);
  color: var(--accent-teal);
  letter-spacing: 1px;
}

/* Navigation Items */
.nav-menu {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 24px;
  flex: 1;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  border-radius: var(--radius-md);
  border: 1px solid transparent;
  background: transparent;
  color: var(--text-secondary);
  font-family: var(--font-main);
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.25s ease;
  width: 100%;
  text-align: left;
}

.nav-item:hover {
  color: var(--text-primary);
  background: rgba(255, 255, 255, 0.03);
  border-color: rgba(255, 255, 255, 0.05);
}

.nav-item.active {
  color: var(--text-primary);
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.18), rgba(139, 92, 246, 0.1));
  border-color: var(--border-active);
  box-shadow: var(--shadow-subtle);
}

.nav-item.active .nav-icon {
  color: var(--accent-violet);
}

.badge-new {
  margin-left: auto;
  font-size: 0.65rem;
  font-family: var(--font-mono);
  background: linear-gradient(135deg, var(--accent-emerald), var(--accent-teal));
  color: #000;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: var(--radius-full);
}

.sidebar-footer {
  margin-top: auto;
  padding-top: 16px;
  border-top: 1px solid var(--border-subtle);
}

.model-status-card {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
}

.status-indicator.online {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent-emerald);
  box-shadow: 0 0 10px var(--accent-emerald);
}

.model-info {
  display: flex;
  flex-direction: column;
}
.model-name {
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--text-primary);
}
.model-latency {
  font-size: 0.65rem;
  color: var(--text-muted);
  font-family: var(--font-mono);
}

/* Main Content Wrapper */
.main-wrapper {
  margin-left: 260px;
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

/* Header */
.top-header {
  height: 72px;
  padding: 0 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(11, 15, 25, 0.7);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--glass-border);
  position: sticky;
  top: 0;
  z-index: 90;
}

.top-nav-bar {
  display: flex;
  align-items: center;
  gap: 4px;
}

.top-nav-item {
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-family: var(--font-main);
  font-size: 0.85rem;
  padding: 8px 16px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: all 0.2s;
  white-space: nowrap;
}

.top-nav-item:hover {
  color: var(--text-primary);
  background: rgba(255, 255, 255, 0.05);
}

.top-nav-item.active {
  color: var(--accent-violet);
  background: rgba(99, 102, 241, 0.1);
}

.header-search {
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-full);
  padding: 8px 16px;
  width: 340px;
  color: var(--text-muted);
}

.header-search input {
  background: transparent;
  border: none;
  outline: none;
  color: var(--text-primary);
  font-family: var(--font-main);
  font-size: 0.85rem;
  width: 100%;
}

.shortcut-key {
  font-size: 0.7rem;
  font-family: var(--font-mono);
  background: rgba(255, 255, 255, 0.08);
  padding: 2px 6px;
  border-radius: 4px;
  color: var(--text-secondary);
}

/* Live Market Ticker */
.live-ticker {
  display: flex;
  align-items: center;
  gap: 20px;
  font-size: 0.8rem;
  font-family: var(--font-mono);
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border-subtle);
  padding: 6px 16px;
  border-radius: var(--radius-full);
}
.t-label {
  color: var(--text-muted);
}
.t-val.pos {
  color: var(--accent-emerald);
}
.t-val.highlight {
  color: var(--accent-teal);
  font-weight: 700;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 16px;
}

.btn-icon {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--glass-border);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  position: relative;
  transition: all 0.2s ease;
}
.btn-icon:hover {
  background: rgba(255, 255, 255, 0.1);
  color: var(--text-primary);
  border-color: var(--glass-border-hover);
}

.pulse-dot {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent-rose);
  box-shadow: 0 0 8px var(--accent-rose);
}

.user-profile {
  display: flex;
  align-items: center;
  gap: 10px;
  padding-left: 12px;
  border-left: 1px solid var(--border-subtle);
}
.avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent-violet), var(--accent-teal));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.85rem;
  font-weight: 700;
  color: #fff;
  box-shadow: var(--glow-primary);
}
.user-meta {
  display: flex;
  flex-direction: column;
}
.user-name {
  font-size: 0.85rem;
  font-weight: 700;
}
.user-role {
  font-size: 0.7rem;
  color: var(--text-muted);
}

/* View Panels */
.view-panel {
  display: none;
  padding: 32px;
  flex: 1;
  animation: fadeIn 0.3s ease forwards;
}
.view-panel.active {
  display: block;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

.view-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 28px;
}
.view-title {
  font-size: 1.75rem;
  font-weight: 800;
  letter-spacing: -0.5px;
}
.view-subtitle {
  font-size: 0.9rem;
  color: var(--text-secondary);
  margin-top: 4px;
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 20px;
  border-radius: var(--radius-md);
  font-family: var(--font-main);
  font-size: 0.85rem;
  font-weight: 700;
  cursor: pointer;
  border: 1px solid transparent;
  transition: all 0.25s ease;
}

.btn-primary {
  background: linear-gradient(135deg, var(--accent-violet), var(--accent-purple));
  color: #ffffff;
  box-shadow: 0 4px 14px rgba(99, 102, 241, 0.35);
}
.btn-primary:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5);
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.05);
  border-color: var(--glass-border);
  color: var(--text-primary);
}
.btn-secondary:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: var(--glass-border-hover);
}

.btn-full {
  width: 100%;
  justify-content: center;
}

.glowing-btn {
  box-shadow: var(--glow-primary);
}

/* Glass Panels */
.glass-panel {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-lg);
  padding: 24px;
  box-shadow: var(--shadow-subtle);
}

/* Metric Cards */
.metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-bottom: 28px;
}

.metric-card {
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-lg);
  padding: 20px;
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}
.metric-card:hover {
  transform: translateY(-3px);
  border-color: var(--glass-border-hover);
}

.glow-violet:hover { box-shadow: var(--glow-primary); }
.glow-teal:hover { box-shadow: var(--glow-emerald); }

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}
.card-label {
  font-size: 0.78rem;
  color: var(--text-secondary);
  font-weight: 600;
}

.trend-badge {
  font-size: 0.7rem;
  font-family: var(--font-mono);
  font-weight: 600;
  padding: 2px 8px;
  border-radius: var(--radius-full);
}
.trend-badge.pos {
  background: rgba(16, 185, 129, 0.15);
  color: var(--accent-emerald);
  border: 1px solid rgba(16, 185, 129, 0.3);
}
.trend-badge.neutral {
  background: rgba(255, 255, 255, 0.08);
  color: var(--text-secondary);
}

.card-value {
  font-size: 1.8rem;
  font-weight: 800;
  letter-spacing: -0.5px;
  margin-bottom: 4px;
}

.card-sub {
  font-size: 0.72rem;
  color: var(--text-muted);
}

.mini-sparkline {
  margin-top: 12px;
}

/* Dashboard Split */
.dashboard-split {
  display: grid;
  grid-template-columns: 2.2fr 1fr;
  gap: 24px;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}
.panel-title {
  font-size: 1.1rem;
  font-weight: 700;
}
.panel-sub {
  font-size: 0.75rem;
  color: var(--text-muted);
  display: block;
}

.chart-controls {
  display: flex;
  gap: 6px;
}
.pill-btn {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-subtle);
  color: var(--text-secondary);
  font-family: var(--font-mono);
  font-size: 0.75rem;
  padding: 4px 10px;
  border-radius: var(--radius-sm);
  cursor: pointer;
}
.pill-btn.active {
  background: var(--accent-violet);
  color: #fff;
  border-color: var(--accent-violet);
}

.chart-container {
  width: 100%;
  height: 320px;
  position: relative;
}
.chart-container canvas {
  width: 100% !important;
  height: 100% !important;
}

/* Activity Feed */
.activity-feed {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-bottom: 24px;
}

.activity-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
}

.act-icon {
  width: 34px;
  height: 34px;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: 0.75rem;
}
.icon-purple { background: rgba(99, 102, 241, 0.2); color: var(--accent-violet); }
.icon-teal { background: rgba(6, 182, 212, 0.2); color: var(--accent-teal); }
.icon-emerald { background: rgba(16, 185, 129, 0.2); color: var(--accent-emerald); }
.icon-amber { background: rgba(245, 158, 11, 0.2); color: var(--accent-amber); }

.act-details {
  display: flex;
  flex-direction: column;
}
.act-title {
  font-size: 0.82rem;
  font-weight: 600;
}
.act-time {
  font-size: 0.7rem;
  color: var(--text-muted);
}

.quick-box-title {
  font-size: 0.85rem;
  font-weight: 700;
  margin-bottom: 10px;
  color: var(--text-secondary);
}
.quick-btns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}
.q-btn {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--glass-border);
  color: var(--text-primary);
  font-size: 0.75rem;
  font-weight: 600;
  padding: 8px 10px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  text-align: left;
  transition: all 0.2s ease;
}
.q-btn:hover {
  background: rgba(99, 102, 241, 0.15);
  border-color: var(--accent-violet);
}

/* GENERATOR WORKSPACE */
.generator-workspace {
  display: grid;
  grid-template-columns: 380px 1fr;
  gap: 24px;
  align-items: start;
}

.control-group {
  margin-bottom: 20px;
}
.control-label {
  display: block;
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 8px;
}

.preset-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.preset-btn {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-subtle);
  color: var(--text-secondary);
  font-size: 0.75rem;
  padding: 6px 12px;
  border-radius: var(--radius-full);
  cursor: pointer;
  transition: all 0.2s ease;
}
.preset-btn.active, .preset-btn:hover {
  background: rgba(99, 102, 241, 0.2);
  color: var(--text-primary);
  border-color: var(--accent-violet);
}

.custom-select, .custom-textarea {
  width: 100%;
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-md);
  padding: 10px 14px;
  color: var(--text-primary);
  font-family: var(--font-main);
  font-size: 0.85rem;
  outline: none;
}
.custom-select:focus, .custom-textarea:focus {
  border-color: var(--accent-violet);
  box-shadow: 0 0 10px rgba(99, 102, 241, 0.2);
}

.slider-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.slider-val {
  font-size: 0.8rem;
  font-family: var(--font-mono);
  color: var(--accent-teal);
  font-weight: 600;
}
.slider-val.highlight {
  color: var(--accent-emerald);
}

.custom-slider {
  width: 100%;
  height: 6px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: var(--radius-full);
  outline: none;
  accent-color: var(--accent-violet);
  margin-top: 6px;
  cursor: pointer;
}

.tag-selector {
  display: flex;
  gap: 8px;
}
.tag-chip {
  font-size: 0.72rem;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-subtle);
  padding: 4px 10px;
  border-radius: var(--radius-sm);
  color: var(--text-muted);
  cursor: pointer;
}
.tag-chip.active {
  background: rgba(6, 182, 212, 0.15);
  color: var(--accent-teal);
  border-color: var(--accent-teal);
}

/* Document Render Body */
.output-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--border-subtle);
  margin-bottom: 20px;
}

.output-title {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-mono);
  font-size: 0.85rem;
  color: var(--text-secondary);
}

.doc-status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent-emerald);
  box-shadow: 0 0 8px var(--accent-emerald);
}
.doc-status-dot.streaming {
  background: var(--accent-amber);
  box-shadow: 0 0 8px var(--accent-amber);
  animation: blink 0.8s infinite alternate;
}

@keyframes blink {
  from { opacity: 0.4; }
  to { opacity: 1; }
}

.btn-icon-text {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-subtle);
  color: var(--text-secondary);
  font-size: 0.75rem;
  padding: 6px 12px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.btn-icon-text:hover {
  background: rgba(255, 255, 255, 0.1);
  color: var(--text-primary);
}

.document-render-body {
  min-height: 480px;
  font-family: var(--font-main);
  font-size: 0.92rem;
  line-height: 1.7;
  color: #E5E7EB;
  background: rgba(0, 0, 0, 0.25);
  padding: 24px;
  border-radius: var(--radius-md);
  border: 1px solid rgba(255, 255, 255, 0.04);
  overflow-y: auto;
  max-height: 600px;
}

.document-render-body h1, .document-render-body h2, .document-render-body h3 {
  color: var(--text-primary);
  margin-top: 20px;
  margin-bottom: 10px;
  letter-spacing: -0.3px;
}
.document-render-body h1 {
  font-size: 1.4rem;
  border-bottom: 1px solid var(--border-subtle);
  padding-bottom: 8px;
}
.document-render-body h2 {
  font-size: 1.15rem;
  color: var(--accent-teal);
}
.document-render-body code {
  font-family: var(--font-mono);
  background: rgba(255, 255, 255, 0.08);
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 0.82rem;
}
.document-render-body pre {
  background: #0D1117;
  padding: 16px;
  border-radius: var(--radius-md);
  overflow-x: auto;
  margin: 14px 0;
  border: 1px solid var(--border-subtle);
}

.doc-table {
  width: 100%;
  border-collapse: collapse;
  margin: 16px 0;
  font-size: 0.85rem;
}
.doc-table th, .doc-table td {
  padding: 10px 14px;
  border: 1px solid var(--border-subtle);
  text-align: left;
}
.doc-table th {
  background: rgba(99, 102, 241, 0.15);
  color: var(--text-primary);
  font-weight: 700;
}

/* FORECASTER GRID */
.scenario-toggles {
  display: flex;
  gap: 8px;
}
.scenario-btn {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-subtle);
  color: var(--text-secondary);
  padding: 8px 16px;
  border-radius: var(--radius-md);
  font-size: 0.8rem;
  font-weight: 700;
  cursor: pointer;
}
.scenario-btn.active {
  background: var(--accent-violet);
  color: #fff;
  border-color: var(--accent-violet);
}
.scenario-btn.bull.active {
  background: var(--accent-emerald);
  border-color: var(--accent-emerald);
}
.scenario-btn.bear.active {
  background: var(--accent-rose);
  border-color: var(--accent-rose);
}

.forecaster-grid {
  display: grid;
  grid-template-columns: 340px 1fr;
  gap: 24px;
}

.computed-metrics-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-bottom: 24px;
}
.c-metric-card {
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  padding: 16px;
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
}
.c-label {
  font-size: 0.72rem;
  color: var(--text-muted);
  font-weight: 600;
}
.c-val {
  font-size: 1.4rem;
  font-weight: 800;
  margin: 4px 0;
  font-family: var(--font-mono);
}
.c-val.pos { color: var(--accent-emerald); }
.c-sub {
  font-size: 0.68rem;
  color: var(--text-secondary);
}

.legend-box {
  display: flex;
  gap: 14px;
  font-size: 0.75rem;
  font-family: var(--font-mono);
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--text-secondary);
}
.dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}
.dot.revenue { background: var(--accent-emerald); }
.dot.cash { background: var(--accent-teal); }
.dot.burn { background: var(--accent-rose); }

/* RISK & ESG MATRIX */
.risk-grid {
  display: grid;
  grid-template-columns: 1fr 400px;
  gap: 24px;
}

.heatmap-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  margin-top: 16px;
}

.heatmap-card {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 18px;
  position: relative;
}
.heatmap-card.low { border-left: 4px solid var(--accent-emerald); }
.heatmap-card.medium { border-left: 4px solid var(--accent-amber); }
.heatmap-card.high { border-left: 4px solid var(--accent-rose); }

.hm-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8px;
}
.hm-title {
  font-weight: 700;
  font-size: 0.88rem;
}
.hm-score {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 700;
}
.low .hm-score { color: var(--accent-emerald); }
.medium .hm-score { color: var(--accent-amber); }
.high .hm-score { color: var(--accent-rose); }

.hm-desc {
  font-size: 0.78rem;
  color: var(--text-secondary);
}

.risk-side-stack {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.radar-container {
  height: 220px;
  position: relative;
  margin-top: 10px;
}

.mitigation-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 14px;
  font-size: 0.8rem;
}
.m-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  margin-right: 6px;
}
.m-dot.red { background: var(--accent-rose); }
.m-dot.amber { background: var(--accent-amber); }
.m-dot.green { background: var(--accent-emerald); }

/* PITCH STUDIO */
.pitch-workspace {
  display: grid;
  grid-template-columns: 240px 1fr;
  gap: 24px;
}

.slide-rail {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.rail-title {
  font-size: 0.85rem;
  color: var(--text-secondary);
  margin-bottom: 4px;
}

.slide-thumb {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-subtle);
  background: rgba(255, 255, 255, 0.02);
  cursor: pointer;
  transition: all 0.2s ease;
}
.slide-thumb.active, .slide-thumb:hover {
  border-color: var(--accent-violet);
  background: rgba(99, 102, 241, 0.1);
}

.s-num {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--accent-teal);
  font-weight: 700;
}
.s-name {
  font-size: 0.8rem;
  font-weight: 600;
}

.stage-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--border-subtle);
}

.theme-selector-box {
  display: flex;
  align-items: center;
  gap: 8px;
}
.theme-chip {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-subtle);
  color: var(--text-secondary);
  font-size: 0.72rem;
  padding: 4px 10px;
  border-radius: var(--radius-sm);
  cursor: pointer;
}
.theme-chip.active {
  background: var(--accent-violet);
  color: #fff;
}

.stage-nav {
  display: flex;
  align-items: center;
  gap: 12px;
}
.slide-counter {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--text-secondary);
}

.slide-canvas {
  min-height: 420px;
  border-radius: var(--radius-lg);
  padding: 40px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  transition: all 0.3s ease;
}

.theme-dark-violet {
  background: linear-gradient(135deg, #0F1225 0%, #1A1F3A 100%);
  border: 1px solid rgba(99, 102, 241, 0.3);
  box-shadow: 0 10px 40px rgba(99, 102, 241, 0.2);
}
.theme-cyber-teal {
  background: linear-gradient(135deg, #081B24 0%, #0F2F3B 100%);
  border: 1px solid rgba(6, 182, 212, 0.3);
  box-shadow: 0 10px 40px rgba(6, 182, 212, 0.2);
}
.theme-gold-luxe {
  background: linear-gradient(135deg, #1A160E 0%, #2E2614 100%);
  border: 1px solid rgba(245, 158, 11, 0.3);
  box-shadow: 0 10px 40px rgba(245, 158, 11, 0.2);
}

.slide-canvas h2 {
  font-size: 2.2rem;
  font-weight: 800;
  margin-bottom: 16px;
  background: linear-gradient(135deg, #FFF, #9CA3AF);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.slide-canvas p {
  font-size: 1.05rem;
  color: #D1D5DB;
  line-height: 1.6;
  max-width: 90%;
  margin-bottom: 24px;
}

.slide-metrics-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
.s-stat-box {
  background: rgba(255, 255, 255, 0.05);
  padding: 16px;
  border-radius: var(--radius-md);
  border: 1px solid rgba(255, 255, 255, 0.1);
}
.s-stat-val {
  font-size: 1.6rem;
  font-weight: 800;
  font-family: var(--font-mono);
  color: var(--accent-emerald);
}
.s-stat-lbl {
  font-size: 0.75rem;
  color: var(--text-muted);
}

/* Toast Container */
.toast-container {
  position: fixed;
  bottom: 24px;
  right: 24px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  z-index: 1000;
}
.toast {
  background: rgba(17, 24, 39, 0.95);
  backdrop-filter: blur(12px);
  border: 1px solid var(--accent-violet);
  color: var(--text-primary);
  padding: 12px 20px;
  border-radius: var(--radius-md);
  font-size: 0.85rem;
  font-weight: 600;
  box-shadow: var(--shadow-subtle);
  animation: slideUp 0.3s ease forwards;
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Mobile Menu Toggle Button */
.mobile-menu-btn {
  display: none;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--glass-border);
  color: var(--text-primary);
  width: 38px;
  height: 38px;
  border-radius: var(--radius-sm);
  align-items: center;
  justify-content: center;
  cursor: pointer;
  margin-right: 12px;
}

/* Search Dropdown Modal/List */
.header-search {
  position: relative;
}

.search-results-dropdown {
  position: absolute;
  top: calc(100% + 8px);
  left: 0;
  width: 100%;
  max-height: 320px;
  background: rgba(15, 21, 35, 0.95);
  backdrop-filter: blur(20px);
  border: 1px solid var(--glass-border-hover);
  border-radius: var(--radius-md);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
  z-index: 1000;
  overflow-y: auto;
  padding: 8px 0;
}

.search-results-dropdown.hidden {
  display: none;
}

.search-result-item {
  padding: 10px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  transition: background 0.15s ease;
}
.search-result-item:hover {
  background: rgba(99, 102, 241, 0.2);
}
.search-result-item .s-res-title {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--text-primary);
}
.search-result-item .s-res-category {
  font-size: 0.68rem;
  font-family: var(--font-mono);
  color: var(--accent-teal);
  background: rgba(6, 182, 212, 0.12);
  padding: 2px 6px;
  border-radius: var(--radius-sm);
}

/* Editable Slide Elements */
[contenteditable="true"] {
  outline: 1px dashed rgba(99, 102, 241, 0.4);
  border-radius: 4px;
  padding: 2px 4px;
  transition: outline 0.2s ease;
}
[contenteditable="true"]:focus {
  outline: 2px solid var(--accent-violet);
  background: rgba(99, 102, 241, 0.1);
}

/* Enhanced Markdown Render Table */
.doc-table tbody tr:nth-child(even) {
  background: rgba(255, 255, 255, 0.02);
}
.doc-table tbody tr:hover {
  background: rgba(99, 102, 241, 0.08);
}
.doc-table td {
  font-family: var(--font-mono);
}

/* Responsive Adjustments */
@media (max-width: 1200px) {
  .metrics-grid { grid-template-columns: repeat(2, 1fr); }
  .dashboard-split { grid-template-columns: 1fr; }
  .generator-workspace { grid-template-columns: 1fr; }
  .forecaster-grid { grid-template-columns: 1fr; }
  .risk-grid { grid-template-columns: 1fr; }
  .pitch-workspace { grid-template-columns: 1fr; }
}

@media (max-width: 860px) {
  .mobile-menu-btn { display: flex; }
  .sidebar {
    transform: translateX(-100%);
    transition: transform 0.3s ease;
    box-shadow: 0 0 30px rgba(0, 0, 0, 0.8);
  }
  .sidebar.mobile-open {
    transform: translateX(0);
  }
  .main-wrapper {
    margin-left: 0;
  }
  .live-ticker { display: none; }
  .header-search { width: 220px; }
  .metrics-grid { grid-template-columns: 1fr; }
}

/* ==========================================================================
   INNOGEN AUTONOMOUS RESEARCH WORKSPACE STYLES
   ========================================================================== */

/* Query Banner Card */
.query-banner-card {
  padding: 24px;
  margin-bottom: 24px;
  border-left: 4px solid var(--accent-indigo);
}

.query-card-header h2 {
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 6px;
}

.query-card-header p {
  font-size: 0.88rem;
  color: var(--text-muted);
  margin-bottom: 20px;
}

.query-input-form textarea {
  width: 100%;
  background: rgba(10, 15, 30, 0.6);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-md);
  padding: 14px 16px;
  font-size: 0.95rem;
  color: var(--text-primary);
  resize: vertical;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.query-input-form textarea:focus {
  outline: none;
  border-color: var(--accent-violet);
  box-shadow: 0 0 15px rgba(139, 92, 246, 0.2);
}

.query-options-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-top: 16px;
  flex-wrap: wrap;
}

.glass-select {
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  padding: 8px 12px;
  color: var(--text-primary);
  font-size: 0.85rem;
}

.checkbox-group label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.85rem;
  color: var(--text-secondary);
  cursor: pointer;
}

/* Job Status Card & 10-Agent Pipeline Bar */
.job-status-card {
  padding: 20px;
  margin-bottom: 24px;
}

.job-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.job-title-group {
  display: flex;
  align-items: center;
  gap: 12px;
}

.status-badge {
  font-size: 0.7rem;
  font-family: var(--font-mono);
  font-weight: 700;
  padding: 4px 8px;
  border-radius: var(--radius-sm);
  text-transform: uppercase;
}

.status-badge.processing {
  background: rgba(245, 158, 11, 0.2);
  color: #F59E0B;
  border: 1px solid rgba(245, 158, 11, 0.4);
}

.status-badge.completed {
  background: rgba(16, 185, 129, 0.2);
  color: var(--accent-emerald);
  border: 1px solid rgba(16, 185, 129, 0.4);
}

.job-metrics {
  display: flex;
  gap: 24px;
}

.job-metric {
  text-align: right;
}

.job-metric .m-val {
  display: block;
  font-family: var(--font-mono);
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--accent-emerald);
}

.job-metric .m-lbl {
  font-size: 0.72rem;
  color: var(--text-muted);
}

/* Pipeline Progress Bar */
.pipeline-progress-wrapper {
  background: rgba(10, 15, 30, 0.5);
  border-radius: var(--radius-md);
  padding: 16px;
  border: 1px solid var(--glass-border);
}

.pipeline-header-label {
  display: flex;
  justify-content: space-between;
  font-size: 0.72rem;
  font-family: var(--font-mono);
  color: var(--text-muted);
  margin-bottom: 12px;
}

.pipeline-header-label .agent-highlight {
  color: var(--accent-teal);
  font-weight: 600;
}

.pipeline-nodes-bar {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));
  gap: 6px;
}

.p-node {
  font-size: 0.68rem;
  font-family: var(--font-mono);
  text-align: center;
  padding: 8px 4px;
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.04);
  color: var(--text-muted);
  border: 1px solid transparent;
  transition: all 0.2s ease;
}

.p-node.running {
  background: rgba(99, 102, 241, 0.25);
  color: #818CF8;
  border-color: #6366F1;
  box-shadow: 0 0 10px rgba(99, 102, 241, 0.3);
}

.p-node.completed {
  background: rgba(16, 185, 129, 0.2);
  color: var(--accent-emerald);
  border-color: rgba(16, 185, 129, 0.4);
}

/* Report Panel */
.report-card {
  padding: 24px;
}

.report-header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--glass-border);
  margin-bottom: 20px;
}

.report-badge {
  font-size: 0.72rem;
  font-family: var(--font-mono);
  font-weight: 700;
  color: var(--accent-teal);
  background: rgba(6, 182, 212, 0.12);
  padding: 4px 10px;
  border-radius: var(--radius-sm);
  border: 1px solid rgba(6, 182, 212, 0.3);
}

.report-render-body {
  font-size: 0.92rem;
  line-height: 1.7;
  color: var(--text-secondary);
}

.report-render-body h1, .report-render-body h2, .report-render-body h3 {
  color: var(--text-primary);
  margin-top: 20px;
  margin-bottom: 10px;
}

.report-placeholder {
  text-align: center;
  padding: 48px 24px;
  color: var(--text-muted);
}

.report-placeholder svg {
  margin-bottom: 16px;
  stroke: var(--text-muted);
}

/* Status Badges in Claims Matrix */
.badge-status {
  font-size: 0.7rem;
  font-family: var(--font-mono);
  font-weight: 700;
  padding: 3px 8px;
  border-radius: var(--radius-sm);
  text-transform: uppercase;
}

.badge-status.VERIFIED {
  background: rgba(16, 185, 129, 0.2);
  color: var(--accent-emerald);
}

.badge-status.PARTIALLY_VERIFIED {
  background: rgba(245, 158, 11, 0.2);
  color: #F59E0B;
}

.badge-status.CONTRADICTED {
  background: rgba(239, 68, 68, 0.2);
  color: #EF4444;
}

.badge-status.UNSUPPORTED {
  background: rgba(148, 163, 184, 0.2);
  color: #94A3B8;
}

/* Agent Graph Visualizer */
.graph-flow-container {
  display: flex;
  justify-content: center;
  padding: 32px 16px;
}

.graph-stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  width: 100%;
  max-width: 640px;
}

.g-node {
  width: 100%;
  padding: 14px 20px;
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-md);
  text-align: center;
  transition: all 0.3s ease;
}

.g-node.active {
  border-color: var(--accent-teal);
  box-shadow: 0 0 15px rgba(6, 182, 212, 0.25);
}

.g-node .g-title {
  display: block;
  font-weight: 700;
  font-size: 0.9rem;
  color: var(--text-primary);
}

.g-node .g-desc {
  font-size: 0.75rem;
  color: var(--text-muted);
}

.g-arrow {
  font-family: var(--font-mono);
  color: var(--accent-teal);
  font-size: 1.2rem;
}

.g-parallel-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  width: 100%;
}

.g-node.worker {
  padding: 10px;
  font-size: 0.78rem;
  font-family: var(--font-mono);
}


